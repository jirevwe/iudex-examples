# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=iudex_tests
DB_USER=iudex
DB_PASSWORD=iudex_dev_password
DB_SSL=false

# Host port mapping (useful if you have multiple instances)
# Docker container uses 5433 to avoid conflict with local Postgres on 5432
POSTGRES_HOST_PORT=5433
DASHBOARD_PORT=3000

# Dashboard Server
PORT=3000
NODE_ENV=development

# Postgres Reporter
POSTGRES_ENABLED=true
REPORTER_BATCH_SIZE=100
